# ===================================
# Mercado Libre Bot Multi-Cuenta
# ===================================

# --- Google Gemini API Key ---
# Obtén tu API key en: https://aistudio.google.com/apikey
GEMINI_API_KEY=TU_GEMINI_API_KEY_AQUI

# --- Configuración del Bot ---
# Modo de respuesta: 'supervised' (apruebas manualmente) o 'automatic' (responde solo)
AUTO_REPLY_MODE=supervised

# Intervalo de polling en minutos (ej: 30 o 60 minutos para pocas consultas al día)
POLLING_INTERVAL_MINUTES=30

# --- Servidor ---
PORT=3000
